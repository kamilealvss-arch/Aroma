# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==================== SUPABASE / POSTGRESQL ====================
# Obtenha estas duas URLs no painel do Supabase:
# Acesse seu projeto Supabase > Project Settings > Database > Connection String > URI
#
# 1. Modo Transaction Pooler (porta 6543) - Para a aplicação rodar em produção:
DATABASE_URL="postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA]@aws-0-[SUA-REGIAO].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Modo Direct Connection (porta 5432) - Para executar migrações e push:
DIRECT_URL="postgresql://postgres.[SEU-PROJECT-REF]:[SUA-SENHA]@aws-0-[SUA-REGIAO].pooler.supabase.com:5432/postgres"
