# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: String de Conexão com o PostgreSQL
# Local (via Docker Compose): postgresql://aroma:aroma123@localhost:5432/aroma_db?schema=public
# Nuvem (Supabase / Neon / Railway): insira a URL fornecida pelo serviço
DATABASE_URL="postgresql://aroma:aroma123@localhost:5432/aroma_db?schema=public"
